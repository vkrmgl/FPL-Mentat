# Warehouse. Rebuildable from `scripts/ingest.py` + `dbt build`, except for
# 2025-26, whose only surviving copy is the Parquet export under data/backups/.
*.db
*.duckdb
*.duckdb.wal

# Keep the portable Parquet archive - it is the recovery path for a season the
# FPL API can no longer serve.
!data/backups/export_*/

.venv/
__pycache__/
*.pyc

# dbt build artefacts
dbt/target/
dbt/dbt_packages/
dbt/logs/
logs/

.ipynb_checkpoints/
.DS_Store

# soccerdata pulls a headless chromedriver into the working directory
downloaded_files/
